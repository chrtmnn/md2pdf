{
  "name": "@chrtmnn/md2pdf",
  "version": "0.1.2",
  "description": "Convert Markdown to PDF from any terminal, with a table of contents and Mermaid diagrams",
  "bin": {
    "md2pdf": "dist/md2pdf.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepack": "pnpm build",
    "pack:check": "node scripts/pack-check.mjs",
    "pack:smoke": "node scripts/package-smoke.mjs",
    "md2pdf": "tsx src/md2pdf.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/test/*.test.ts\"",
    "test:coverage": "node --import tsx --enable-source-maps --experimental-test-coverage --test-coverage-exclude=\"src/test/**\" --test \"src/test/*.test.ts\"",
    "smoke": "tsx src/md2pdf.ts -u --css-var heading-break-before=page README.md"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrtmnn/md2pdf.git"
  },
  "keywords": [
    "markdown",
    "md2pdf",
    "mermaid",
    "toc",
    "pdf"
  ],
  "author": "C.J. Hartmann <c@hrtmnn.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chrtmnn/md2pdf/issues"
  },
  "homepage": "https://github.com/chrtmnn/md2pdf#readme",
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "commander": "15.0.0",
    "doctoc": "2.5.0",
    "md-to-pdf": "5.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
